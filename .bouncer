{
  "rules": {
    "long-function": { "enabled": true, "severity": "error", "params": { "maxLines": 10 } },
    "missing-documentation": { "enabled": true, "severity": "error", "params": { "scope": "all" } },
    "swift-debug-print": { "enabled": false }
  },
  "exclude": [
    "Tests/**", "**/*.md", ".build/**", "Sources/CTreeSitterPython/**", "Sources/CTreeSitterTypeScript/**",
    "Sources/CTreeSitterTSX/**", "Sources/CTreeSitterJavaScript/**", "Sources/CTreeSitterObjC/**",
    "Sources/CTreeSitterRust/**", "Scripts/windows-vm/autounattend.xml",
    "Sources/BouncerReporting/RuleCatalogText.swift"
  ]
}
